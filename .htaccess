# ian.lu — transport security and response headers (added 23 Sep 2026).
# Plesk serves through nginx -> Apache; these apply to what Apache answers.
# Verify any change from OUTSIDE this Mac: after ~20 quick requests the host's
# Imunify360 shield answers with a "One moment, please..." page instead.

# --- Force HTTPS -------------------------------------------------------------
# http://ian.lu served the whole site unencrypted (verified 23 Sep 2026), so a
# network attacker could rewrite the sign-in page. The X-Forwarded-Proto check
# keeps this from looping if nginx ever terminates TLS and proxies plain HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Security headers ----------------------------------------------------------
# NOT EFFECTIVE for pages/assets as of 23 Sep 2026 (verified from outside):
# Plesk has nginx serve static files directly, so .html/.js/.css requests
# never reach Apache and these lines don't apply to them. The real fix is in
# Plesk: Apache & nginx Settings -> 'Additional nginx directives' (add_header
# ... always;) and SSL It! -> HSTS. Kept here so they apply if that changes.
<IfModule mod_headers.c>
  # Browsers must not guess content types (scripts/styles are served correctly).
  Header always set X-Content-Type-Options "nosniff"
  # Pages may be framed only by ian.lu itself -- stops clickjacking of the
  # messenger and admin pages. PixelBreak's srcdoc iframes are unaffected.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS starts SHORT (5 min) so a mistake can't lock visitors out. Once HTTPS
  # is confirmed everywhere, raise it: max-age=31536000 (one year).
  Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on'"
  # Camera, microphone and location only for ian.lu's own pages and frames
  # (face scan, Kamera-Arcade, calls, bus stops), never for a third-party frame.
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=()"
</IfModule>

# STILL NOT EFFECTIVE on 15 Nov 2026 (security audit, checked from outside):
# https://ian.lu/ and /auth.js answer with NO security header at all, so the
# site can be framed by any other site (clickjacking) and has no HSTS.
# Paste this into Plesk -> ian.lu -> Apache & nginx Settings -> "Additional
# nginx directives" (it is the same set as above, in nginx syntax):
#
#   add_header X-Content-Type-Options "nosniff" always;
#   add_header X-Frame-Options "SAMEORIGIN" always;
#   add_header Referrer-Policy "strict-origin-when-cross-origin" always;
#   add_header Strict-Transport-Security "max-age=300" always;
#   add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=()" always;
#   add_header Content-Security-Policy-Report-Only "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
#
# X-Frame-Options SAMEORIGIN keeps the arcade working: its game frames are
# srcdoc / same-origin. The CSP line is report-only on purpose (nothing can
# break); a real script-src policy needs the inline scripts moved out first.
# Then raise HSTS to max-age=31536000 once a week has passed without trouble.

AddType application/manifest+json .webmanifest

# --- Removed pages -------------------------------------------------------------
# Class chat was removed on 23 Sep 2026; send old bookmarks and the PWA
# shortcut to the messenger instead of a 404.
Redirect 301 /classchat.html /messenger.html

# Short link for the chats-only "Noriichten" home-screen app.
RedirectMatch 302 ^/noriichten/?$ /inbox.html?app=noriichten
