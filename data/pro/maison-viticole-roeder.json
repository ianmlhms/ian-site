     "q": {
      "fr": "Vos vins sont-ils bio ?",
      "de": "Sind Ihre Weine bio?",
      "en": "Are your wines organic?"
     },
     "a": {
      "fr": "Oui, le domaine travaille en viticulture biologique, et la récolte se fait entièrement à la main.",
      "de": "Ja, das Weingut arbeitet biologisch, und die Lese erfolgt vollständig von Hand.",
      "en": "Yes, the estate works organically, and the harvest is done entirely by hand."
     }
    },
    {
     "q": {
      "fr": "Peut-on visiter sans rendez-vous ?",
      "de": "Kann man ohne Termin vorbeikommen?",
      "en": "Can we visit without an appointment?"
     },
     "a": {
      "fr": "Pour acheter, oui, aux heures d'ouverture. Pour une dégustation guidée, mieux vaut prévenir.",
      "de": "Zum Einkaufen ja, während der Öffnungszeiten. Für eine geführte Probe besser vorher Bescheid geben.",
      "en": "To buy, yes, during opening hours. For a guided tasting, better to let us know first."
     }
    },
    {
     "q": {
      "fr": "Recevez-vous des groupes ?",
      "de": "Empfangen Sie Gruppen?",
      "en": "Do you take groups?"
     },
     "a": {
      "fr": "Oui, jusqu'à une trentaine de personnes. Dites-nous combien vous êtes et quand.",
      "de": "Ja, bis etwa dreißig Personen. Sagen Sie uns, wie viele Sie sind und wann.",
      "en": "Yes, up to about thirty people. Tell us how many you are and when."
     }
    },
    {
     "q": {
      "fr": "Livrez-vous ?",
      "de": "Liefern Sie?",
      "en": "Do you deliver?"
     },
     "a": {
      "fr": "Au Luxembourg, oui, à partir de six bouteilles. Écrivez-nous, on s'arrange.",
      "de": "Innerhalb Luxemburgs ja, ab sechs Flaschen. Schreiben Sie uns, wir finden eine Lösung.",
      "en": "Within Luxembourg, yes, from six bottles. Write to us and we will arrange it."
     }
    }
