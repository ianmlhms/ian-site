   "items": [
    {
     "q": {
      "fr": "Faut-il réserver ?",
      "de": "Muss man reservieren?",
      "en": "Do I need to book?"
     },
     "a": {
      "fr": "Ce n'est pas obligatoire, mais le week-end et pour la terrasse c'est plus sûr. Un coup de téléphone suffit.",
      "de": "Nicht zwingend, aber am Wochenende und für die Terrasse ist es sicherer. Ein Anruf genügt.",
      "en": "Not compulsory, but safer at the weekend and for the terrace. A phone call is enough."
     }
    },
    {
     "q": {
      "fr": "Y a-t-il une terrasse ?",
      "de": "Gibt es eine Terrasse?",
      "en": "Is there a terrace?"
     },
     "a": {
      "fr": "Oui, elle est ouverte dès qu'il fait assez beau.",
      "de": "Ja, sie ist geöffnet, sobald das Wetter es zulässt.",
      "en": "Yes, it opens as soon as the weather is good enough."
     }
    },
    {
     "q": {
      "fr": "Peut-on jouer aux quilles ?",
      "de": "Kann man kegeln?",
      "en": "Can we play skittles?"
     },
     "a": {
      "fr": "Oui. Le jeu de quilles se réserve à l'avance, surtout en soirée.",
      "de": "Ja. Die Kegelbahn wird im Voraus reserviert, besonders abends.",
      "en": "Yes. The skittle alley is booked in advance, especially in the evening."
     }
    },
    {
     "q": {
      "fr": "Prenez-vous les groupes et les fêtes de famille ?",
      "de": "Nehmen Sie Gruppen und Familienfeiern an?",
      "en": "Do you take groups and family celebrations?"
     },
     "a": {
      "fr": "Oui, la salle se prépare pour les grandes tablées. Écrivez-nous ce que vous avez en tête.",
      "de": "Ja, der Saal wird für große Tafeln hergerichtet. Schreiben Sie uns, was Sie vorhaben.",
      "en": "Yes, the room is laid out for long tables. Write and tell us what you have in mind."
     }
    },
    {
     "q": {
      "fr": "Dans quelles langues êtes-vous ?",
      "de": "In welchen Sprachen?",
